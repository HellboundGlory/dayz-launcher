{
  "schemaVersion": 2,
  "variants": [
    {
      "minWidth": 0,
      "root": {
        "type": "stack",
        "direction": "column",
        "height": "100%",
        "grow": 1,
        "minWidth": "0px",
        "children": [
          {
            "type": "stack",
            "id": "r-filterbar",
            "direction": "column",
            "children": [
              {
                "type": "stack",
                "id": "r-filterbar-top",
                "direction": "row",
                "align": "center",
                "minWidth": "0px",
                "children": [
                  {
                    "element": "filter.search",
                    "options": {
                      "showIcon": true
                    }
                  },
                  {
                    "element": "filter.map"
                  },
                  {
                    "element": "filter.tags"
                  },
                  {
                    "element": "filter.mods"
                  },
                  {
                    "element": "filter.region"
                  },
                  {
                    "element": "filter.maxPing"
                  }
                ],
                "wrap": true
              },
              {
                "type": "stack",
                "id": "r-filterbar-bottom",
                "direction": "row",
                "align": "center",
                "minWidth": "0px",
                "children": [
                  {
                    "type": "stack",
                    "id": "r-hides",
                    "direction": "row",
                    "align": "center",
                    "children": [
                      {
                        "element": "filter.hideEmpty"
                      },
                      {
                        "element": "filter.hideFull"
                      },
                      {
                        "element": "filter.hideLocked"
                      },
                      {
                        "element": "filter.hideOffline"
                      }
                    ]
                  },
                  {
                    "element": "filter.reset",
                    "options": {
                      "display": "iconLabel"
                    }
                  },
                  {
                    "element": "servers.refresh",
                    "options": {
                      "display": "iconLabel"
                    }
                  }
                ]
              }
            ],
            "shrink": 0
          },
          {
            "element": "notice.launch"
          },
          {
            "type": "stack",
            "direction": "row",
            "grow": 1,
            "minHeight": "0px",
            "children": [
              {
                "element": "list.servers",
                "grow": 1,
                "minWidth": "0px",
                "minHeight": "0px"
              },
              {
                "type": "stack",
                "id": "r-detail",
                "context": "selection",
                "direction": "column",
                "children": [
                  {
                    "type": "stack",
                    "id": "r-detail-body",
                    "direction": "column",
                    "children": [
                      {
                        "type": "stack",
                        "id": "r-identity",
                        "direction": "column",
                        "children": [
                          {
                            "type": "stack",
                            "id": "r-title",
                            "direction": "row",
                            "align": "start",
                            "children": [
                              {
                                "element": "server.name"
                              },
                              {
                                "element": "server.deselect"
                              }
                            ]
                          },
                          {
                            "element": "server.address",
                            "options": {
                              "showGamePort": true
                            }
                          },
                          {
                            "element": "server.tags",
                            "options": {
                              "officialWording": "official",
                              "showBattleye": true,
                              "showModUpdate": false
                            }
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "id": "r-stats",
                        "direction": "row",
                        "children": [
                          {
                            "type": "stack",
                            "direction": "column",
                            "class": "t-stat",
                            "children": [
                              {
                                "element": "server.players",
                                "options": {
                                  "showCaption": false,
                                  "showQueue": false
                                }
                              },
                              {
                                "type": "text",
                                "value": "Players",
                                "role": "label",
                                "class": "t-stat-label"
                              }
                            ]
                          },
                          {
                            "type": "stack",
                            "direction": "column",
                            "class": "t-stat",
                            "children": [
                              {
                                "element": "server.ping",
                                "options": {
                                  "showCaption": false
                                }
                              },
                              {
                                "type": "text",
                                "value": "Ping ms",
                                "role": "label",
                                "class": "t-stat-label"
                              }
                            ]
                          },
                          {
                            "type": "stack",
                            "direction": "column",
                            "class": "t-stat",
                            "children": [
                              {
                                "element": "server.gameTime"
                              },
                              {
                                "type": "text",
                                "value": "Time",
                                "role": "label",
                                "class": "t-stat-label"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "element": "server.readiness",
                        "options": {
                          "basis": "declared"
                        }
                      },
                      {
                        "type": "stack",
                        "id": "r-props",
                        "direction": "column",
                        "children": [
                          {
                            "type": "stack",
                            "direction": "row",
                            "align": "baseline",
                            "class": "t-prop",
                            "children": [
                              {
                                "type": "text",
                                "value": "Map",
                                "role": "label",
                                "class": "t-prop-label"
                              },
                              {
                                "element": "server.map"
                              }
                            ]
                          },
                          {
                            "type": "stack",
                            "direction": "row",
                            "align": "baseline",
                            "class": "t-prop",
                            "children": [
                              {
                                "type": "text",
                                "value": "Version",
                                "role": "label",
                                "class": "t-prop-label"
                              },
                              {
                                "element": "server.version"
                              }
                            ]
                          },
                          {
                            "type": "stack",
                            "direction": "row",
                            "align": "baseline",
                            "class": "t-prop",
                            "children": [
                              {
                                "type": "text",
                                "value": "Region",
                                "role": "label",
                                "class": "t-prop-label"
                              },
                              {
                                "element": "server.region"
                              }
                            ]
                          },
                          {
                            "type": "stack",
                            "direction": "row",
                            "align": "baseline",
                            "class": "t-prop",
                            "children": [
                              {
                                "type": "text",
                                "value": "Mods",
                                "role": "label",
                                "class": "t-prop-label"
                              },
                              {
                                "element": "server.modCount",
                                "options": {
                                  "showCaption": false
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "id": "r-detail-toolbar",
                        "direction": "row",
                        "children": [
                          {
                            "element": "server.checkMods",
                            "options": {
                              "display": "icon"
                            }
                          },
                          {
                            "element": "server.subscribeAll",
                            "options": {
                              "display": "icon"
                            }
                          },
                          {
                            "element": "server.unsubscribeUnique",
                            "options": {
                              "display": "icon",
                              "label": "Unsubscribe unique"
                            }
                          },
                          {
                            "element": "server.copyAddress",
                            "options": {
                              "display": "icon"
                            }
                          }
                        ]
                      },
                      {
                        "element": "server.downloadSize"
                      }
                    ]
                  },
                  {
                    "element": "list.serverMods",
                    "grow": 1,
                    "minHeight": "0px",
                    "minWidth": "0px",
                    "options": {
                      "header": false
                    }
                  },
                  {
                    "type": "stack",
                    "id": "r-actions",
                    "direction": "column",
                    "children": [
                      {
                        "element": "server.actionNotice"
                      },
                      {
                        "type": "stack",
                        "id": "r-join",
                        "direction": "row",
                        "children": [
                          {
                            "element": "server.join",
                            "options": {
                              "wording": "fixAndJoin"
                            }
                          },
                          {
                            "element": "server.cancel"
                          },
                          {
                            "element": "server.menu",
                            "options": {
                              "menu": "serverLoad",
                              "icon": "chevronDown",
                              "label": "Load this server's mods to the main menu"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "id": "r-browser"
      }
    },
