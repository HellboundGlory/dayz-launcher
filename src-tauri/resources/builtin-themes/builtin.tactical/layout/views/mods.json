{
  "schemaVersion": 2,
  "root": {
    "type": "stack",
    "id": "r-mods",
    "direction": "column",
    "height": "100%",
    "grow": 1,
    "minWidth": "0px",
    "children": [
      {
        "type": "stack",
        "id": "r-mods-toolbar",
        "direction": "row",
        "align": "center",
        "children": [
          {
            "element": "mods.search",
            "grow": 1
          },
          {
            "element": "mods.statusFilter"
          },
          {
            "element": "mods.refresh"
          }
        ]
      },
      {
        "element": "notice.modsError"
      },
      {
        "element": "notice.modsCached"
      },
      {
        "element": "notice.modsOutdated"
      },
      {
        "type": "stack",
        "id": "r-mods-body",
        "direction": "row",
        "grow": 1,
        "minHeight": "0px",
        "children": [
          {
            "element": "list.mods",
            "grow": 1,
            "minWidth": "0px",
            "minHeight": "0px"
          },
          {
            "type": "stack",
            "id": "r-mod-detail",
            "context": "modSelection",
            "direction": "column",
            "children": [
              {
                "type": "stack",
                "id": "r-mod-hero",
                "direction": "row",
                "children": [
                  {
                    "element": "mod.thumbnail"
                  },
                  {
                    "element": "mod.disabledBadge"
                  }
                ]
              },
              {
                "type": "stack",
                "id": "r-mod-content",
                "direction": "column",
                "children": [
                  {
                    "element": "mod.deselect"
                  },
                  {
                    "element": "mod.name"
                  },
                  {
                    "type": "stack",
                    "id": "r-mod-status",
                    "direction": "row",
                    "align": "center",
                    "children": [
                      {
                        "element": "mod.status"
                      }
                    ]
                  },
                  {
                    "element": "mod.tags",
                    "options": {
                      "limit": 6,
                      "style": "chips"
                    }
                  },
                  {
                    "element": "mod.description",
                    "options": {
                      "clamp": 6
                    }
                  },
                  {
                    "type": "stack",
                    "id": "r-mod-props",
                    "direction": "column",
                    "children": [
                      {
                        "type": "stack",
                        "direction": "row",
                        "align": "baseline",
                        "class": "t-mod-prop",
                        "children": [
                          {
                            "type": "text",
                            "value": "Subscribed",
                            "role": "label",
                            "class": "t-mod-prop-label"
                          },
                          {
                            "element": "mod.subscribed"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "direction": "row",
                        "align": "baseline",
                        "class": "t-mod-prop",
                        "children": [
                          {
                            "type": "text",
                            "value": "Updated",
                            "role": "label",
                            "class": "t-mod-prop-label"
                          },
                          {
                            "element": "mod.updated"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "direction": "row",
                        "align": "baseline",
                        "class": "t-mod-prop",
                        "children": [
                          {
                            "type": "text",
                            "value": "Size",
                            "role": "label",
                            "class": "t-mod-prop-label"
                          },
                          {
                            "element": "mod.size"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "direction": "row",
                        "align": "baseline",
                        "class": "t-mod-prop",
                        "children": [
                          {
                            "type": "text",
                            "value": "Rating",
                            "role": "label",
                            "class": "t-mod-prop-label"
                          },
                          {
                            "element": "mod.rating"
                          }
                        ]
                      },
                      {
                        "type": "stack",
                        "direction": "row",
                        "align": "baseline",
                        "class": "t-mod-prop",
                        "children": [
                          {
                            "type": "text",
                            "value": "Workshop id",
                            "role": "label",
                            "class": "t-mod-prop-label"
                          },
                          {
                            "element": "mod.workshopId"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "id": "r-mod-actions",
                    "direction": "column",
                    "children": [
                      {
                        "element": "mod.openInSteam",
                        "options": {
                          "display": "iconLabel"
                        }
                      },
                      {
                        "type": "stack",
                        "id": "r-mod-action-row",
                        "direction": "row",
                        "children": [
                          {
                            "element": "mod.openFolder",
                            "options": {
                              "display": "iconLabel"
                            },
                            "grow": 1
                          },
                          {
                            "element": "mod.reinstall",
                            "options": {
                              "display": "iconLabel"
                            },
                            "grow": 1
                          }
                        ]
                      },
                      {
                        "element": "mod.update",
                        "options": {
                          "display": "iconLabel"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "element": "notice.modsResult"
      },
      {
        "type": "stack",
        "id": "r-mods-actions",
        "direction": "row",
        "align": "center",
        "children": [
          {
            "element": "mods.count"
          },
          {
            "element": "mods.selectAll",
            "options": {
              "display": "label"
            }
          },
          {
            "element": "mods.clearSelection"
          },
          {
            "type": "stack",
            "id": "r-mods-actions-right",
            "direction": "row",
            "align": "center",
            "children": [
              {
                "element": "mods.selectUnique"
              },
              {
                "element": "mods.cleanupRemoved"
              },
              {
                "element": "mods.updateOutdated"
              },
              {
                "type": "stack",
                "id": "r-mods-unsubscribe",
                "direction": "row",
                "gap": "space.0",
                "children": [
                  {
                    "element": "mods.unsubscribe"
                  },
                  {
                    "element": "mods.unsubscribeMenu"
                  }
                ]
              },
              {
                "type": "stack",
                "id": "r-mods-verify",
                "direction": "row",
                "gap": "space.0",
                "children": [
                  {
                    "element": "mods.verify"
                  },
                  {
                    "element": "mods.verifyMenu"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
