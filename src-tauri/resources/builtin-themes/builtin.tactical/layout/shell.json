                    "options": {
                      "display": "iconLabel"
                    }
                  },
                  {
                    "element": "nav.mods",
                    "options": {
                      "display": "iconLabel"
                    }
                  }
                ]
              },
              {
                "element": "app.dragRegion",
                "grow": 1
              },
              {
                "element": "status.steam"
              },
              {
                "element": "nav.settings",
                "options": {
