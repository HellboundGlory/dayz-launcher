          },
          {
            "type": "stack",
            "id": "r-footer",
            "direction": "row",
            "align": "center",
            "justify": "spaceBetween",
            "landmark": "contentinfo",
            "children": [
              {
                "type": "stack",
                "id": "r-footer-stats",
                "direction": "row",
                "align": "center",
                "children": [
                  {
                    "element": "status.serverTotal"
                  },
                  {
                    "element": "status.populated"
                  },
                  {
                    "element": "status.lastRefreshed",
                    "options": {
                      "label": "refreshed"
                    }
                  }
                ]
              },
              {
                "element": "app.uiScale",
                "options": {
                  "label": "Scale"
                }
              }
            ],
            "shrink": 0
          },
          {
            "type": "outlet",
            "name": "modals"
          }
        ]
      }
    }
  ]
}
