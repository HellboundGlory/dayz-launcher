{
  "schemaVersion": 2,
  "placement": { "mode": "center" },
  "backdrop": "dim",
  "root": {
    "type": "stack",
    "direction": "column",
    "children": [
      {
        "type": "stack",
        "direction": "row",
        "align": "center",
        "justify": "spaceBetween",
        "children": [
          { "element": "modal.close" },
          { "element": "server.name" }
        ]
      },
      { "element": "server.address" },
      { "element": "server.tags" },
      {
        "type": "stack",
        "direction": "row",
        "children": [
          { "element": "server.players" },
          { "element": "server.ping" }
        ]
      },
      {
        "type": "stack",
        "direction": "row",
        "children": [
          { "element": "server.map" },
          { "element": "server.gameTime" }
        ]
      },
      { "element": "list.serverMods" },
      {
        "type": "stack",
        "direction": "row",
        "children": [
          { "element": "server.join" },
          { "element": "server.actionNotice" }
        ]
      }
