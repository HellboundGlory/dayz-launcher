{
  "productName": "Tetra Launcher",
  "version": "1.0.2",
  "identifier": "com.tetra.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tetra Launcher",
        "width": 1400,
        "minWidth": 975,
        "height": 800,
        "minHeight": 700,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "steam_api64.dll"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERjQ1QjlEODYxNUNBREMKUldUY3loV0duVnYwblJSMjBySTA5VFJ3bkphTWJ2NEpveHA4NEJBcW1wYUYwdnNMdnFZL0ZSdkcK",
      "endpoints": [
        "https://github.com/HellboundGlory/dayz-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}