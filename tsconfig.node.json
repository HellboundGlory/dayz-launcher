{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Vitest ships its own Vite; point its types at the Vite this project builds
    // with so the config's `test` block type-checks against one Vite.
    "paths": { "vite": ["./node_modules/vite"] }
  },
  "include": ["vite.config.ts"]
}