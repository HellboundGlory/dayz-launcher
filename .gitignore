# Build output
/dist
/target
/src-tauri/gen/schemas
/src-tauri/permissions/autogenerated/

# Dependencies
/node_modules

# Local runtime data — machine-specific, not source
tetra.db
tetra.db-shm
tetra.db-wal

# Design-rationale notes mirroring the source tree, kept local
.ai-notes/

# Editor / tooling
.claude/
*.log

# Agent instructions — local only, not published
CLAUDE.md
AGENTS.md

# Harness scratch output (prod build, server logs) — regenerable
/tools/harness/.out/

# Visual baselines — regenerable with `npm run harness:visual`
/tools/harness/baselines/

# Backend deployment secrets — holds the Steam Web API key
deploy/.env

# Local backend index URL for debug builds — the host is not published here
/src-tauri/.cargo/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
