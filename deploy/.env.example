# Copy to `.env` (same directory) and set STEAM_API_KEY. `.env` is gitignored
# and excluded from the Docker build context — the key never enters an image.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Every value below is the built-in default, so a working .env only needs
# STEAM_API_KEY. Uncommented lines are shown for editability, not because they
# must be set.

# --- required ----------------------------------------------------------------

# Steam Web API key: https://steamcommunity.com/dev/apikey
# The account does NOT need to own DayZ, and this server does NOT need Steam
# installed — GetServerList is a plain HTTPS call. No default; the service
# refuses to start without it.
STEAM_API_KEY=

# --- storage and binding -----------------------------------------------------

# SQLite file. Must be on the /data volume to survive a container replacement.
TETRA_INDEX_DB=/data/index.sqlite

# Listen address inside the container. Compose maps it to 127.0.0.1:8080 on the
# host; keep this 0.0.0.0 so the port mapping works.
TETRA_INDEX_BIND=0.0.0.0:8080

# --- crawl schedule ----------------------------------------------------------
#
# Steam Web API quota is ~100,000 calls/day per key. A full crawl measured
# 1,249 requests (probe output), so at 1200 s (72 crawls/day) that is ~90,000
# — near the ceiling, with the hot pull on top. This cadence is deliberately
# just inside budget; do the arithmetic before lowering it: 86400 / interval
# * 1249. Below ~1,080 s the quota is exhausted before the day ends.

# Hot pull: one request for `\appid\221100\empty\1` (every populated server,
# 2,507 rows today). Cheap, so it can be frequent.
TETRA_HOT_INTERVAL_SECS=60

# Full recursive crawl: population -> tag axes -> map axes -> name_match a-z0-9.
TETRA_FULL_INTERVAL_SECS=1200

# --- A2S_INFO sweep (live players, name, map) --------------------------------

# How often to start a sweep of known addresses.
TETRA_INFO_INTERVAL_SECS=180

# Max addresses per sweep. Large enough to cover the whole table in one pass.
TETRA_INFO_BATCH=60000

# --- A2S_RULES sweep (mod list, description) ---------------------------------

# Rules are far more expensive per server than info, so they run in a rolling
# backlog: oldest/never-probed responsive rows first.
TETRA_RULES_INTERVAL_SECS=60
TETRA_RULES_BATCH=4000

# Re-probe a server's mod list once its stored copy is this old (6 h).
TETRA_RULES_TTL_SECS=21600

# --- concurrency and limits --------------------------------------------------

# Simultaneous in-flight A2S probes, i.e. open UDP sockets. Each is an fd, so
# this and the compose `ulimits.nofile` move together. Ceiling is 2048.
TETRA_MAX_IN_FLIGHT=1024

# Parallel Steam Web API requests during a full crawl.
TETRA_CRAWL_CONCURRENCY=16

# Maximum addresses accepted from one IP in a full crawl; 0 disables. The Steam
# master lists 273k DayZ addresses from only 8,014 IPs; 88 of those IPs
# advertise 1,001-10,000 ports each and account for 186k addresses with zero
# players between them (advert spam that answers A2S, so probing cannot tell it
# apart). A populated server is never dropped regardless of this cap. At 50 the
# index holds ~29k real servers instead of 273k, and the snapshot is ~19 MB
# JSON / ~0.9 MB gzip instead of 163 MB / 6.9 MB.
TETRA_MAX_PER_IP=50

# HTTP requests per minute per client IP before the API answers 429.
TETRA_RATE_LIMIT_PER_MIN=60

# --- logging -----------------------------------------------------------------

# `tracing_subscriber` env filter. `info` is the operational level;
# `info,tetra_indexer=debug` while diagnosing a crawl.
RUST_LOG=info
