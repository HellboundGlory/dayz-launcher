# Deny-list for the indexer image: everything `cargo build -p tetra-indexer` never reads. Workspace member manifests stay in.

# Rust build output — `target/` is tens of GB locally and is rebuilt in-image
target/

# Frontend: the indexer has no web assets
node_modules/
dist/
src-tauri/gen/
public/
docs/

# VCS and editor/tooling state
.git/
.github/
.gitignore
.claude/
.vscode/
.idea/
*.log

# Local secrets — never bake the Steam key into an image layer
deploy/.env
.env
.env.local

# Local untracked notes (gitignored; not source)
.ai-notes/
graft/
CLAUDE.md
AGENTS.md

# Windows-only Steam redistributable, and local launcher databases
src-tauri/steam_api64.dll
tetra.db
tetra.db-shm
tetra.db-wal
